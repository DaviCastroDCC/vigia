# Copie para .env e troque os valores. O .env não vai para o Git.
DB_USER=vigia
DB_PASSWORD=troque-esta-senha
# Gere com: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres
# Opcional: token do bot criado no @BotFather, para alertas no Telegram
TELEGRAM_BOT_TOKEN=
# Conta cujos serviços públicos aparecem para todos (página pública e painel). Vazio = sem vitrine
SHOWCASE_OWNER_EMAIL=
