[Unit]
Description=Vigia: publica a versão nova da main se o CI passou
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Mesmo usuário dono do repositório; ele está no grupo docker, então não precisa de root.
User=ec2-user
WorkingDirectory=/home/ec2-user/vigia
ExecStart=/usr/bin/bash /home/ec2-user/vigia/deploy/auto-deploy.sh
TimeoutStartSec=900
